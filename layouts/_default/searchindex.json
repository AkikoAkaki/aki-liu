{{- /* Per-language site search index. Hugo emits one file per language. */ -}}
{{- $sections := site.MainSections | append "microblog" -}}
{{- $pages := where site.RegularPages "Section" "in" $sections -}}
{{- with site.GetPage "/influences" -}}
    {{- $pages = $pages | append . -}}
{{- end -}}
{{- $items := slice -}}
{{- range $pages -}}
    {{- $body := .Plain | htmlUnescape | strings.TrimSpace -}}
    {{- $summary := "" -}}
    {{- with .Description -}}{{- $summary = . -}}{{- end -}}
    {{- if eq $summary "" -}}
        {{- $summary = .Summary | plainify | strings.TrimSpace -}}
    {{- end -}}
    {{- $summary = $summary | htmlUnescape -}}
    {{- if gt (len $summary) 280 -}}
        {{- $summary = (substr $summary 0 280) -}}
    {{- end -}}
    {{- $tags := slice -}}
    {{- if and (in site.MainSections .Section) (ne .Params.hidden true) -}}
        {{- range .Params.tags -}}
            {{- $tags = $tags | append (dict "name" . "slug" (. | urlize) "label" (partial "tag-label.html" .)) -}}
        {{- end -}}
    {{- end -}}
    {{- $title := .Title | htmlUnescape -}}
    {{- if eq .Section "microblog" -}}
        {{- $title = partial "microblog-title.html" (dict "page" . "max" 70) -}}
    {{- end -}}
    {{- $rec := dict
        "id"      (printf "%s::%s" .RelPermalink .Language.Lang)
        "title"   $title
        "section" (.Section | default .Title)
        "url"     .RelPermalink
        "date"    (.Date.Format "2006-01-02")
        "tags"    $tags
        "lang"    .Language.Lang
        "summary" $summary
        "body"    $body
    -}}
    {{- $items = $items | append $rec -}}
{{- end -}}
{{- $items | jsonify -}}
