{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ .Title }} on {{ .Site.Title }}</title>
        <link>{{ .Permalink }}</link>
        <description>{{ with .Description }}{{ . }}{{ else }}Recent fragments on {{ .Site.Title }}{{ end }}</description>
        <generator>Hugo</generator>
        <language>{{ .Site.LanguageCode }}</language>
        {{- with .Site.Lastmod }}
        <lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
        {{- end }}
        <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
        {{- $entries := where .Site.RegularPages "Section" "microblog" }}
        {{- $entries = $entries.ByDate.Reverse }}
        {{- range first 30 $entries }}
        {{- $plain := .Plain | strings.TrimSpace }}
        {{- $itemTitle := $plain }}
        {{- if gt (len $itemTitle) 80 }}
            {{- $itemTitle = printf "%s…" (substr $itemTitle 0 80) }}
        {{- end }}
        {{- if eq $itemTitle "" }}
            {{- $itemTitle = printf "Fragment %s" (.Date.Format "2006-01-02 · 15:04") }}
        {{- end }}
        <item>
            <title>{{ $itemTitle }}</title>
            <link>{{ .Permalink }}</link>
            <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
            <guid>{{ .Permalink }}</guid>
            <description>{{ .Content | html }}</description>
            {{- range .Params.tags }}
            <category>{{ . }}</category>
            {{- end }}
        </item>
        {{- end }}
    </channel>
</rss>
